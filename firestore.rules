rules_version = '2';

/*
 * Regras de segurança do Loft.
 *
 * Princípio geral: ninguém deslogado lê ou escreve nada, e pertencimento a
 * grupo é sempre comprovado por um exists() no documento de membership.
 *
 * DUAS COISAS QUE REGRAS NÃO FAZEM, e que moldaram este arquivo:
 *
 *  1. Regras não fazem query. Não há como perguntar "existe ALGUM convite para
 *     este grupo?". Só dá para conferir um convite cujo código o cliente
 *     informe — por isso a membership guarda `inviteCode`.
 *
 *  2. Dentro de um writeBatch, get()/exists() enxergam o estado ANTERIOR à
 *     transação. Ao criar um grupo, no instante em que a membership de dono e
 *     os canais iniciais são avaliados, o grupo e a membership ainda não
 *     existem. Por isso as duas regras aceitam a assinatura de "estou criando
 *     este grupo agora": o grupo ainda não existe.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------- auxiliares ---------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    // Imagem do perfil (etapa 2b): só WebP ou JPEG em base64, até `max`
    // caracteres — o mesmo formato e teto de src/lib/images.ts. Nada que
    // vire outra coisa dentro de um `src` ou `url(...)` na tela de outra pessoa.
    function imageOk(value, max) {
      return value is string && value.size() <= max
        && value.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$');
    }

    function uid() {
      return request.auth.uid;
    }

    // O id determinístico da membership é o que permite checar pertencimento
    // com um exists() direto, sem query.
    function membershipPath(groupId) {
      return /databases/$(database)/documents/memberships/$(groupId + '_' + uid());
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && exists(membershipPath(groupId));
    }

    function isOwner(groupId) {
      return signedIn()
        && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.ownerId == uid();
    }

    /*
     * CARGOS E PERMISSÕES (0.8.5). O carteiro calcula o que cada pessoa pode
     * e grava na membership dela: `perms` (no servidor), `canais` (canal a
     * canal, só onde há regra própria), `topo` (posição do cargo mais alto) e
     * `castigoAte`. Sem `perms` (grupo de antes dos cargos, ou o carteiro
     * ainda não passou), vale o @todos — e sem @todos, o que todo membro já
     * podia fazer antes. O dono sempre pode tudo.
     */
    function minha(groupId) {
      return get(membershipPath(groupId)).data;
    }

    function todosPath(groupId) {
      return /databases/$(database)/documents/cargos/$(groupId + '_todos');
    }

    function permsPadrao(groupId) {
      return exists(todosPath(groupId))
        ? get(todosPath(groupId)).data.permissoes
        : [
        'apelido-proprio', 'ver-canal', 'ler-antigas', 'mandar-mensagens', 'responder', 'mandar-fotos',
        'mandar-gifs', 'mandar-videos', 'mandar-audio', 'mandar-figurinhas', 'mandar-links', 'previa-links',
        'mencionar-pessoas', 'usar-comandos', 'ver-galeria', 'ver-sala', 'entrar', 'falar',
        'transmitir', 'transmitir-som', 'camera', 'ver-chat-sala', 'escrever-chat-sala', 'mandar-enquetes',
        'votar-enquetes', 'visualizacao-unica', 'transcricao', 'mini-jogos-iniciar', 'mini-jogos-jogar', 'reagir',
        'mandar-arquivos'
      ];
    }

    function permsServidor(groupId) {
      return minha(groupId).get('perms', permsPadrao(groupId));
    }

    function emCastigo(groupId) {
      return minha(groupId).get('castigoAte', null) != null
        && minha(groupId).castigoAte > request.time;
    }

    /** Pode fazer `p` no servidor (castigo tira tudo, menos ver e ler). */
    function pode(groupId, p) {
      return isOwner(groupId)
        || (isMember(groupId) && !emCastigo(groupId)
            && permsServidor(groupId).hasAny(['administrador', p]));
    }

    /** O canal (ou a categoria dele, sincronizada) tem regra própria? */
    function temRegras(groupId, channelId) {
      let canal = get(/databases/$(database)/documents/channels/$(channelId)).data;
      return canal.get('permissoes', {}).size() > 0
        || (canal.get('categoryId', '') != ''
            && get(groupPath(groupId)).data.get('permsCategorias', {}).get(canal.get('categoryId', ''), {}).size() > 0);
    }

    /**
     * O que posso NESTE canal. Calculado pelo carteiro em `canais`; se ainda
     * não foi calculado e o canal tem regra própria, nada (fecha até o
     * carteiro passar — canal privado nunca abre por engano).
     */
    function permsDoCanal(groupId, channelId) {
      let m = minha(groupId);
      return channelId in m.get('canais', {})
        ? m.canais[channelId]
        : (temRegras(groupId, channelId) ? [] : permsServidor(groupId));
    }

    /** Pode fazer `p` neste canal (com as regras próprias do canal). */
    function podeNoCanal(groupId, channelId, p) {
      return isOwner(groupId)
        || (isMember(groupId) && !emCastigo(groupId)
            && permsDoCanal(groupId, channelId).hasAny(['administrador', p]));
    }

    /** Vê o canal (castigo não tira isto): texto pede "Ver canal"; voz, "Ver a sala". */
    function podeVer(groupId, channelId) {
      return isOwner(groupId)
        || (isMember(groupId)
            && permsDoCanal(groupId, channelId).hasAny(['administrador',
                 get(/databases/$(database)/documents/channels/$(channelId)).data.get('kind', 'text') == 'voice'
                   ? 'ver-sala' : 'ver-canal']));
    }

    // "Este grupo ainda não existe" é a assinatura de estar criando ele agora,
    // dentro do writeBatch. Ver observação 2 no topo.
    function groupBeingCreated(groupId) {
      return signedIn() && !exists(groupPath(groupId));
    }

    /**
     * O e-mail desta conta foi confirmado?
     *
     * Cobrado no BANCO, e não só na tela: quem contorna a interface passa
     * direto por qualquer verificação que exista só no cliente. É o que impede
     * alguém de cadastrar com e-mail alheio e tomar um `@` que fica preso numa
     * conta que ninguém controla.
     */
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    /** Fui bloqueado por esta pessoa? A regra lê o que o cliente não pode. */
    function blockedBy(otherUid) {
      return exists(/databases/$(database)/documents/blocks/$(otherUid + '_' + uid()));
    }

    /** Eu bloqueei esta pessoa? Espelha `blockedBy`, na direção contrária. */
    function iBlocked(otherUid) {
      return exists(/databases/$(database)/documents/blocks/$(uid() + '_' + otherUid));
    }

    /**
     * O OUTRO uid de um par PV, a partir do id determinístico — sem ler
     * nenhum documento. `pairId` aqui é uma STRING (o `threadId` gravado na
     * mensagem, ou o path wildcard de `dmThreads`), não um objeto: dá para
     * usar tanto onde `resource`/`request.resource` existem quanto onde não
     * (ver o comentário grande em `dmMessages`, abaixo).
     */
    function otherInPair(pairId) {
      return pairId.split('_')[0] == uid() ? pairId.split('_')[1] : pairId.split('_')[0];
    }

    /*
     * LIGAÇÃO NO PV (0.9.5). A chamada de dois amigos usa a mesma voz dos
     * grupos, com um "grupo" de mentira: `pv_{a}_{b}` (o par em ordem). Só os
     * dois entram, e ninguém bloqueado.
     */
    function parDoPv(g) {
      return g.split('_')[1] + '_' + g.split('_')[2];
    }
    function ehDoPv(g) {
      return signedIn() && g is string
        && g.matches('pv_[A-Za-z0-9]+_[A-Za-z0-9]+')
        && parDoPv(g).split('_').hasAny([uid()])
        && !blockedBy(otherInPair(parDoPv(g)))
        && !iBlocked(otherInPair(parDoPv(g)));
    }
    /** Membro do grupo, ou um dos dois da ligação no PV. */
    function naVoz(g) {
      return isMember(g) || ehDoPv(g);
    }

    // Confere um convite CUJO CÓDIGO o cliente informou.
    function inviteMatches(groupId, code) {
      return code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.groupId == groupId;
    }

    /* ------------------------------- users ------------------------------ */
    // Qualquer autenticado lê (o painel de membros precisa dos nomes de todos
    // do grupo); só o dono escreve o próprio documento.

    match /users/{userId} {
      // PÚBLICO para autenticados de propósito: é o que faz a busca por `@`
      // funcionar. Por isso este documento não pode conter e-mail nem
      // configuração — o privado mora em `userPrivate/{uid}`.
      allow read: if signedIn();

      allow create: if signedIn() && userId == uid();

      /*
       * O LIMITE DE TROCAS DE `@` É COBRADO AQUI.
       *
       * Na tela ele seria decorativo. `usernameChanges` só pode subir de um em
       * um e nunca passar do teto, então nem gastando todas as trocas alguém
       * volta ao começo reescrevendo o contador.
       *
       * Mexer em `username` sem mexer no contador também é recusado: são a
       * mesma operação, e separá-las seria a brecha óbvia.
       */
      allow update: if signedIn() && userId == uid()
        && profileLookOk()
        && (
          request.resource.data.get('username', '') == resource.data.get('username', '')
          || (
            verified()
            && request.resource.data.get('usernameChanges', 0)
                 == resource.data.get('usernameChanges', 0) + 1
            && request.resource.data.get('usernameChanges', 0) <= 3
          )
        );

      /*
       * PERFIL (proposta A, etapa 2). Só o que MUDOU é cobrado: contas
       * antigas com nome comprido seguem entrando (o login regrava o nome
       * igual). Cor e fonte são listas fechadas — as mesmas de
       * src/lib/person-theme.ts —, nunca texto livre que vire CSS na tela de
       * outra pessoa.
       */
      function changed(field) {
        return request.resource.data.get(field, null) != resource.data.get(field, null);
      }
      function profileLookOk() {
        let d = request.resource.data;
        return (!changed('displayName')
                  || (d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 32))
          && (!changed('bio') || d.get('bio', '') is string && d.get('bio', '').size() <= 160)
          && (!changed('accentId')
                || d.get('accentId', 'roxo') in ['roxo', 'rosa', 'verde', 'azul', 'laranja', 'claro'])
          && (!changed('fontId')
                || d.get('fontId', 'nunito') in ['nunito', 'classica', 'pixelada', 'forte'])
          && (!changed('photo') || !('photo' in d) || imageOk(d.photo, 90000))
          && (!changed('nameColor')
                || d.get('nameColor', 'padrao')
                     in ['padrao', 'roxo', 'rosa', 'vermelho', 'laranja', 'amarelo', 'verde', 'azul'])
          && (!changed('customStatus') || !('customStatus' in d) || statusOk(d.customStatus))
          && (!changed('links') || !('links' in d) || linksOk(d.links));
      }

      /*
       * STATUS (etapa 2d): emoji curto, texto até 60, prazo em milissegundos
       * (0 = sem prazo). Só estas três chaves.
       */
      function statusOk(s) {
        return s is map
          && s.keys().hasOnly(['emoji', 'text', 'until'])
          && s.get('emoji', '') is string && s.get('emoji', '').size() <= 16
          && s.get('text', '') is string && s.get('text', '').size() <= 60
          && s.get('until', 0) is int && s.get('until', 0) >= 0;
      }

      /*
       * LINKS (etapa 2d): até 3, cada um https:// e até 200 caracteres, sem
       * espaço, aspas nem < > — só endereço de site, nunca javascript: e afins.
       */
      function linkOk(l) {
        return l is string && l.size() <= 200 && l.matches('https://[^\\s<>"]+');
      }
      function linksOk(ls) {
        return ls is list && ls.size() >= 1 && ls.size() <= 3
          && linkOk(ls[0])
          && (ls.size() < 2 || linkOk(ls[1]))
          && (ls.size() < 3 || linkOk(ls[2]));
      }

      allow delete: if signedIn() && userId == uid();
    }

    /* ---------------------------- userPrivate --------------------------- */
    // Existe desde já para a Entrega 3 não precisar migrar nada. NADA aqui é
    // legível por outra pessoa — é o par privado de `users`.

    /* ---------------------------- profileArt ---------------------------- */
    // Banner e fundo do cartão (etapa 2b). Separados de `users/` para a lista
    // de membros não baixar imagem grande que nem mostra. Qualquer um logado
    // lê (é o cartão público); só o dono escreve, e só estes dois campos.

    match /profileArt/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['banner', 'cardBg'])
        && (!('banner' in request.resource.data) || imageOk(request.resource.data.banner, 300000))
        && (!('cardBg' in request.resource.data) || imageOk(request.resource.data.cardBg, 300000));
      allow delete: if signedIn() && userId == uid();
    }

    match /userPrivate/{userId} {
      allow read, write: if signedIn() && userId == uid();

      /*
       * FUNDO DO CHAT (proposta A, etapa 5c): um documento por fundo
       * (`geral` ou o id de um canal). Só o dono, só estes campos, imagem no
       * mesmo formato das outras e véu de 0 a 90%.
       */
      match /fundos/{chave} {
        allow read, delete: if signedIn() && userId == uid();
        allow create, update: if signedIn() && userId == uid()
          && request.resource.data.keys().hasOnly(['image', 'dim', 'label'])
          && imageOk(request.resource.data.image, 400000)
          && request.resource.data.dim is int
          && request.resource.data.dim >= 0 && request.resource.data.dim <= 90
          && (!('label' in request.resource.data)
                || (request.resource.data.label is string && request.resource.data.label.size() <= 80));
      }
    }

    /* ----------------------------- usernames ---------------------------- */
    /*
     * A RESERVA DO `@`. O id do documento É o nome.
     *
     * O Firestore não tem restrição de unicidade; quem garante é a chave
     * primária. Duas pessoas tomando o mesmo nome no mesmo instante: a segunda
     * perde no `create`, porque criar documento que já existe é recusado pelo
     * SERVIDOR — não por uma checagem do cliente que pode chegar tarde.
     */

    match /usernames/{name} {
      // Leitura aberta: é como a busca por `@` encontra alguém, e o documento
      // só contém um uid — nada mais.
      //
      // `get` (UM nome) vale até sem login: é o aviso de "@ livre" do
      // cadastro, antes de a conta existir. Não revela nada novo — qualquer
      // um cria uma conta e lê o mesmo. `list` (varrer todos) segue exigindo
      // login.
      allow get: if true;
      allow list: if signedIn();

      allow create: if verified() && request.resource.data.uid == uid();

      // Nunca se altera: trocar de `@` é apagar esta e criar outra, no mesmo
      // lote. Sem isto, dava para apontar o nome de outra pessoa para si.
      allow update: if false;

      allow delete: if signedIn() && resource.data.uid == uid();
    }

    /* ---------------------------- friendships --------------------------- */
    /*
     * UM documento por PAR, id `${menorUid}_${maiorUid}`.
     *
     * Ninguém lê a amizade alheia: a leitura exige estar em `members`. E
     * ninguém se adiciona à lista de outro, porque não há lista de outro —
     * criar exige ser o remetente E estar no par.
     */

    match /friendships/{pairId} {
      /*
       * `get` e `list` PRECISAM de regras diferentes aqui — medido, não
       * suposto: juntar os dois num `allow read` só com o `pairId` derrubou
       * `list` com "Null value error", porque o wildcard do caminho só
       * existe de verdade quando o Firestore resolve UM documento. Numa
       * consulta não há documento nenhum sendo resolvido ainda, então
       * `pairId` chega `null` e `.split('_')` estoura.
       *
       * `get` precisa do `pairId`: `resource` é `null` quando o documento
       * ainda não existe, e todo PRIMEIRO pedido de amizade é exatamente
       * essa leitura. Checar `resource.data.members` contra `null` erra na
       * avaliação — e o Firestore trata erro de avaliação como recusa —,
       * então `sendFriendRequest` nunca conseguia nem verificar se o par já
       * tinha documento. Como `create` já obriga `members` a ser derivado
       * do próprio `pairId`, e `update` nunca deixa `members` mudar, checar
       * o `pairId` é a MESMA informação, só que também vale para quando o
       * documento ainda não existe.
       *
       * `list` não tem esse problema — uma consulta nunca "casa" com
       * documento inexistente —, e continua na forma original, que é a
       * única que o Firestore consegue provar segura contra o
       * `where('members', 'array-contains', uid)` do cliente.
       */
      allow get: if signedIn() && pairId.split('_').hasAny([uid()]);
      allow list: if signedIn() && uid() in resource.data.members;

      allow create: if verified()
        && request.resource.data.from == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.members.hasOnly([
             request.resource.data.from, request.resource.data.to
           ])
        && request.resource.data.from != request.resource.data.to
        // O id é derivado dos uids ordenados: é isto que garante UM documento
        // por par e faz pedidos cruzados caírem no mesmo lugar.
        && pairId == (
             request.resource.data.from < request.resource.data.to
               ? request.resource.data.from + '_' + request.resource.data.to
               : request.resource.data.to + '_' + request.resource.data.from
           )
        // Bloqueio cobrado no servidor, sem expor a lista a quem envia.
        && !blockedBy(request.resource.data.to);

      /*
       * ACEITAR é só de quem RECEBEU. `A` não aceita pedido endereçado a `B`,
       * nem o próprio remetente aceita o que mandou.
       */
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && resource.data.to == uid()
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Recusar, cancelar e desfazer: qualquer um dos dois lados apaga.
      allow delete: if signedIn() && uid() in resource.data.members;
    }

    /* ------------------------------ blocks ------------------------------ */
    // SÓ EU leio e escrevo a minha lista. Assimétrico de propósito: bloquear
    // alguém não me bloqueia lá.

    match /blocks/{blockId} {
      allow read, delete: if signedIn() && resource.data.uid == uid();
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && blockId == uid() + '_' + request.resource.data.blockedUid;
      allow update: if false;
    }

    /* ----------------------------- dmThreads ----------------------------- */
    /*
     * A CONVERSA privada — um documento por PAR, id `${menorUid}_${maiorUid}`
     * (mesma forma de `friendships`, mesmo motivo: um lugar só, venha de que
     * lado vier). Sem dono, sem canal — etapa 18.
     */

    match /dmThreads/{pairId} {
      /*
       * MESMO PROBLEMA de `friendships`, MESMA SOLUÇÃO: `get` e `list`
       * precisam de regras diferentes. `get` usa o `pairId` do PATH — vale
       * mesmo em documento que ainda não existe (o clique num amigo, antes
       * da primeira mensagem). `list` (a lista de conversas) não tem
       * `pairId` vinculado numa consulta — só `resource.data.members`, que
       * nunca é `null` numa listagem (documento inexistente não aparece
       * nela).
       */
      allow get: if signedIn() && pairId.split('_').hasAny([uid()]);
      allow list: if signedIn() && uid() in resource.data.members;

      allow create: if verified()
        && uid() in request.resource.data.members
        && request.resource.data.members.size() == 2
        && pairId == (
             request.resource.data.members[0] < request.resource.data.members[1]
               ? request.resource.data.members[0] + '_' + request.resource.data.members[1]
               : request.resource.data.members[1] + '_' + request.resource.data.members[0]
           )
        && !blockedBy(otherInPair(pairId))
        && !iBlocked(otherInPair(pairId));

      /*
       * SÓ o resumo da última mensagem muda — `members` nunca troca depois
       * de criado. E o autor DENTRO do resumo tem que ser eu: sem isto,
       * qualquer um dos dois poderia escrever "a última mensagem foi da
       * outra pessoa" e mentir sobre quem falou por último.
       */
      allow update: if signedIn()
        && uid() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
        && request.resource.data.lastMessage.authorId == uid();

      allow delete: if false; // fora de escopo na etapa 18
    }

    /* ----------------------------- dmMessages ----------------------------- */
    /*
     * Mensagem de conversa PRIVADA. Sem `groupId`/`channelId` — o único
     * vínculo é `threadId`, igual ao id do `dmThreads` correspondente.
     *
     * NENHUMA regra aqui faz get() no doc de `dmThreads`. De propósito: a
     * lição da etapa 16 foi que `resource.data` num documento que talvez
     * não exista (lá, a friendship antes do primeiro pedido; aqui, a THREAD
     * antes da primeira mensagem) derruba a regra inteira, porque o
     * Firestore trata erro de avaliação como recusa. `threadId` é campo da
     * PRÓPRIA mensagem, sempre presente em `resource`/`request.resource`
     * independente de o documento da thread existir — por isso `otherInPair`
     * funciona igual nos dois casos, sem nunca precisar olhar para o outro
     * lado.
     */

    /*
     * VISUALIZAÇÃO ÚNICA (0.10.0): `unica.vezes` de 1 a 5, só foto ou vídeo,
     * e o arquivo na pasta fechada do carteiro (`unica/`), que só entrega
     * pelo POST /unica/abrir contando as vezes. Mensagem sem `unica` não
     * pode apontar para a pasta fechada (nem o contrário).
     */
    function unicaOk(d) {
      let anexo = d.get('attachment', {});
      let fechado = anexo.get('chave', '') is string && anexo.get('chave', '').matches('^unica/.*');
      return !('unica' in d)
        ? !fechado
        : (d.unica is map && d.unica.keys().hasOnly(['vezes'])
           && d.unica.vezes is int && d.unica.vezes >= 1 && d.unica.vezes <= 5
           && d.get('kind', 'text') in ['image', 'video']
           && fechado);
    }

    /*
     * REAÇÕES (0.11.0): `reacoes` é um mapa uid → lista de emojis. Quem reage
     * só mexe na PRÓPRIA chave (nada mais da mensagem muda), até 6 emojis.
     */
    function soMinhaReacao() {
      let antes = resource.data.get('reacoes', {});
      let depois = request.resource.data.get('reacoes', {});
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacoes'])
        && depois is map
        && depois.diff(antes).affectedKeys().hasOnly([uid()])
        && (!(uid() in depois) || (depois[uid()] is list && depois[uid()].size() <= 6));
    }

    match /dmMessages/{messageId} {
      allow read: if signedIn() && resource.data.threadId.split('_').hasAny([uid()]);

      allow create: if signedIn()
        && request.resource.data.threadId.split('_').hasAny([uid()])
        && request.resource.data.authorId == uid()
        && unicaOk(request.resource.data)
        && !blockedBy(otherInPair(request.resource.data.threadId))
        && !iBlocked(otherInPair(request.resource.data.threadId));

      // Só o autor, só o texto — mesma disciplina de `messages`.
      allow update: if signedIn()
        && resource.data.authorId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt']);

      // 0.11.0: reagir — os dois do PV (sem bloqueio), só a própria reação.
      allow update: if signedIn()
        && resource.data.threadId.split('_').hasAny([uid()])
        && !blockedBy(otherInPair(resource.data.threadId))
        && !iBlocked(otherInPair(resource.data.threadId))
        && soMinhaReacao();

      // Só o autor apaga: PV não tem dono, não tem moderação.
      allow delete: if signedIn() && resource.data.authorId == uid();
    }

    /* --------------------------- pinnedMessages -------------------------- */
    /*
     * Mensagem FIXADA — de um CANAL (grupo) ou de uma THREAD (PV), nunca os
     * dois. `'channelId' in resource.data` decide qual metade da regra
     * vale, igual a como `dmMessages` decide por `threadId` estar presente.
     *
     * SEM get() em documento que pode não existir — ao contrário do pedido
     * de amizade da etapa 16, aqui não há nada parecido para checar: criar
     * não depende de "esta mensagem já está fixada?" (o cliente evita isso
     * olhando a lista já carregada, e uma fixada repetida não quebra nada,
     * só duplica visualmente — a tela agrupa por messageId ao exibir).
     * Apagar sempre mira um id que o cliente já tem na lista carregada,
     * nunca um chute. `isOwner`/`isMember` fazem get() no GRUPO, não na
     * fixada, e o grupo de um canal real sempre existe.
     *
     * ids são AUTOGERADOS (sem id determinístico) — por isso `read` não
     * precisa do mesmo split get/list de `friendships`/`dmThreads`: o
     * cliente nunca faz um `getDoc` chutando um id de fixada que talvez não
     * exista, só `list` (que nunca "casa" com documento inexistente).
     */

    match /pinnedMessages/{pinId} {
      allow read: if signedIn() && (
        ('channelId' in resource.data)
          ? podeVer(resource.data.groupId, resource.data.channelId)
          : resource.data.threadId.split('_').hasAny([uid()])
      );

      // Só o DONO fixa no grupo (conteúdo que todo mundo vê; qualquer
      // membro poder fixar viraria bagunça). No PV, qualquer um dos dois.
      allow create: if signedIn() && (
        ('channelId' in request.resource.data)
          ? podeNoCanal(request.resource.data.groupId, request.resource.data.channelId, 'fixar')
          : request.resource.data.threadId.split('_').hasAny([uid()])
      ) && request.resource.data.pinnedBy == uid();

      // Mesma gente que pode fixar pode desafixar.
      allow delete: if signedIn() && (
        ('channelId' in resource.data)
          ? podeNoCanal(resource.data.groupId, resource.data.channelId, 'desafixar')
          : resource.data.threadId.split('_').hasAny([uid()])
      );

      // Fixada é imutável — desafixar é apagar, não editar.
      allow update: if false;
    }

    /* ------------------------------ groups ------------------------------ */
    // Só membros leem. Qualquer autenticado cria, virando dono na mesma
    // operação. Só o dono altera ou apaga.

    match /groups/{groupId} {
      allow read: if isMember(groupId);
      // `verified()` desde a etapa 14: conta com e-mail não confirmado não cria
      // grupo, nem contornando a tela. Nome obrigatório (etapa 3a).
      allow create: if verified() && request.resource.data.ownerId == uid()
        && groupNameOk(request.resource.data.get('name', ''));
      // 0.8.5: cada campo com a sua permissão. `permsCategorias` (regras das
      // categorias) só o carteiro grava.
      allow update: if isMember(groupId)
        && request.resource.data.ownerId == resource.data.ownerId
        && !groupChanged('permsCategorias')
        && (!groupChanged('name') || pode(groupId, 'editar-nome'))
        && (!groupChanged('photo') || pode(groupId, 'editar-foto'))
        && (!groupChanged('description') || pode(groupId, 'editar-descricao'))
        && (!groupChanged('welcome') || pode(groupId, 'editar-boas-vindas'))
        && (!groupChanged('accentId') || pode(groupId, 'editar-cor'))
        && (!groupChanged('categories') || pode(groupId, 'gerenciar-categorias') || pode(groupId, 'ordenar-canais'))
        && groupLookOk();
      allow delete: if isOwner(groupId);

      function groupNameOk(name) {
        return name is string && name.trim().size() >= 1 && name.size() <= 60;
      }
      function groupChanged(field) {
        return request.resource.data.get(field, null) != resource.data.get(field, null);
      }
      /*
       * "PERFIL" DO GRUPO (etapa 3a). Como no perfil de pessoa, só o que
       * MUDOU é cobrado — grupos antigos seguem editáveis. Cor é a lista
       * fechada da cor do cartão; foto como a foto de perfil.
       */
      function groupLookOk() {
        let d = request.resource.data;
        return (!groupChanged('name') || groupNameOk(d.get('name', '')))
          && (!groupChanged('description')
                || !('description' in d)
                || (d.description is string && d.description.size() <= 300))
          && (!groupChanged('accentId')
                || d.get('accentId', 'roxo') in ['roxo', 'rosa', 'verde', 'azul', 'laranja', 'claro'])
          && (!groupChanged('photo') || !('photo' in d) || imageOk(d.photo, 90000))
          // Etapa 3b: categorias de canais — lista de até 20 (cada uma {id, name};
          // a regra não percorre listas, então o cliente lê com cuidado).
          && (!groupChanged('categories') || !('categories' in d)
                || (d.categories is list && d.categories.size() <= 20))
          // Etapa 3c: boas-vindas até 500.
          && (!groupChanged('welcome') || !('welcome' in d)
                || (d.welcome is string && d.welcome.size() <= 500));
      }
    }

    /* ----------------------------- groupArt ----------------------------- */
    // Banner do grupo (etapa 3a). Separado de `groups/` porque o grupo é lido
    // inteiro para desenhar as abas — banner grande ali pesaria em toda tela.
    // Membros leem; só o dono escreve, e só o banner.

    match /groupArt/{groupId} {
      allow read: if isMember(groupId);
      allow create, update: if pode(groupId, 'editar-banner')
        && request.resource.data.keys().hasOnly(['banner'])
        && (!('banner' in request.resource.data) || imageOk(request.resource.data.banner, 300000));
      allow delete: if isOwner(groupId) || pode(groupId, 'editar-banner');
    }

    /* --------------------------- memberships ---------------------------- */

    match /memberships/{membershipId} {
      // `resource == null` precisa ser permitido: a tela de convite consulta a
      // MINHA membership num grupo em que provavelmente não estou, e sem isto
      // o documento inexistente devolveria permission-denied em vez de "não
      // existe", quebrando o fluxo do convite.
      allow read: if signedIn()
        && (resource == null
            || resource.data.memberId == uid()
            || isMember(resource.data.groupId));

      // Só crio a MINHA membership, com o id determinístico, e em um de dois
      // casos: estou criando o grupo agora (viro dono), ou tenho um convite
      // válido para ele (entro como membro).
      allow create: if signedIn()
        && request.resource.data.memberId == uid()
        && membershipId == request.resource.data.groupId + '_' + uid()
        && (
             (request.resource.data.role == 'owner'
               && groupBeingCreated(request.resource.data.groupId))
             ||
             (request.resource.data.role == 'member'
               && !exists(/databases/$(database)/documents/banidos/$(request.resource.data.groupId + '_' + uid()))
               && !('perms' in request.resource.data) && !('canais' in request.resource.data)
               && !('castigoAte' in request.resource.data) && request.resource.data.get('cargos', []).size() == 0
               && inviteMatches(
                    request.resource.data.groupId,
                    request.resource.data.get('inviteCode', '')
                  ))
           );

      // Duas formas de uma membership acabar:
      //   - eu saio do grupo (apago a minha);
      //   - o dono me remove, ou apaga o grupo inteiro na cascata.
      allow delete: if signedIn()
        && (resource.data.memberId == uid() || isOwner(resource.data.groupId));

      // Ninguém promove ninguém por update — o papel é definido na criação e não
      // muda. É também o que impede alguém se auto-declarar dono depois.
      // PENDÊNCIA: transferir posse vai precisar mexer aqui.
      //
      // 0.8.5: cargos, perms, topo, canais e castigo — tudo pelo carteiro,
      // que confere permissão e hierarquia antes de gravar.
      allow update: if false;
    }

    /* ------------------------------ cargos ------------------------------ */
    // 0.8.5: cargos livres do grupo. Ler é de todo membro (a cor e o ícone
    // aparecem para todo mundo). O @todos tem id fixo `${groupId}_todos`.

    match /cargos/{cargoId} {
      allow read: if isMember(resource.data.groupId);
      // Criar, editar, ordenar e apagar: pelo carteiro (permissão "Gerenciar
      // cargos" + hierarquia). O dono apaga na cascata de apagar o grupo.
      allow create, update: if false;
      allow delete: if isOwner(resource.data.groupId);
    }

    /* ------------------------------- lentos ----------------------------- */
    // 0.8.5: a marca do modo lento (`${canal}_${uid}`): só a própria pessoa,
    // e sempre com a hora do servidor (não dá para "voltar no tempo").

    match /lentos/{lentoId} {
      allow read: if signedIn() && lentoId.split('_')[1] == uid();
      allow create, update: if signedIn()
        && lentoId == request.resource.data.channelId + '_' + uid()
        && request.resource.data.em == request.time
        && request.resource.data.keys().hasOnly(['channelId', 'em']);
    }

    /* ------------------------------ registro ---------------------------- */
    // 0.8.5: quem fez o quê no grupo. Só o carteiro escreve; lê quem tem
    // "Ver registro de auditoria".

    match /registro/{registroId} {
      allow read: if pode(resource.data.groupId, 'ver-registro');
      allow create, update: if false;
      // A cascata de apagar o grupo leva o registro junto.
      allow delete: if isOwner(resource.data.groupId);
    }

    /* ------------------------------ comandos ---------------------------- */
    // 0.8.5: comandos personalizados do grupo (/regras…). Todo membro lê (a
    // lista do "/"); quem cria e edita é o carteiro (permissões de comando).

    match /comandos/{comandoId} {
      allow read: if isMember(resource.data.groupId);
      allow create, update: if false;
      allow delete: if isOwner(resource.data.groupId);
    }

    /* ------------------------------ banidos ----------------------------- */
    // 0.8.5: `${groupId}_${uid}`. Só o carteiro escreve; lê quem pode desbanir.

    match /banidos/{banidoId} {
      allow read: if pode(resource.data.groupId, 'desbanir') || pode(resource.data.groupId, 'banir');
      allow create, update: if false;
      allow delete: if isOwner(resource.data.groupId);
    }


    /* ----------------------------- channels ----------------------------- */

    match /channels/{channelId} {
      // Ler é de todo membro. MEXER é só do dono.
      // Ler a LISTA de canais é de todo membro (a consulta é por grupo, e regra
      // não filtra canal a canal). O que é privado é o CONTEÚDO: mensagens e
      // fixadas cobram `podeVer`. O app esconde da lista o canal que não vê.
      allow read: if isMember(resource.data.groupId);

      // O `groupBeingCreated` cobre os três canais iniciais criados no mesmo
      // writeBatch do grupo, quando nem o grupo nem a membership existem ainda —
      // isOwner faria get() num documento que ainda não está lá.
      // Custo conhecido: um autenticado pode criar canais apontando para um
      // groupId que não existe. São documentos órfãos, invisíveis para todo
      // mundo — nenhuma query do app os alcança, e assim que o grupo existe de
      // verdade só o dono escreve nele.
      allow create: if (pode(request.resource.data.groupId, 'criar-canais')
          && !('permissoes' in request.resource.data))
        || groupBeingCreated(request.resource.data.groupId);

      // Renomear canal não pode mudá-lo de grupo nem de tipo. Etapa 3b: nome,
      // emoji, categoria e posição são cobrados quando mudam.
      // 0.8.5: nome/emoji = "Editar canais"; categoria/posição = "Mudar a
      // ordem" (ou editar). As regras do canal (`permissoes`) só o carteiro.
      allow update: if isMember(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'emoji', 'categoryId', 'position', 'lento'])
        && ((!channelChanged('name') && !channelChanged('emoji') && !channelChanged('lento'))
              || podeNoCanal(resource.data.groupId, channelId, 'editar-canais'))
        && ((!channelChanged('categoryId') && !channelChanged('position'))
              || pode(resource.data.groupId, 'ordenar-canais')
              || podeNoCanal(resource.data.groupId, channelId, 'editar-canais'))
        && channelLookOk();

      function channelChanged(field) {
        return request.resource.data.get(field, null) != resource.data.get(field, null);
      }
      function channelLookOk() {
        let d = request.resource.data;
        return (!channelChanged('name')
                  || (d.name is string && d.name.trim().size() >= 1 && d.name.size() <= 60))
          && (!channelChanged('emoji') || !('emoji' in d)
                || (d.emoji is string && d.emoji.size() <= 16))
          && (!channelChanged('categoryId') || !('categoryId' in d)
                || (d.categoryId is string && d.categoryId.size() <= 40))
          && (!channelChanged('position') || (d.position is int && d.position >= 0 && d.position < 1000))
          // 0.8.5: modo lento, de 0 (desligado) a 6 horas.
          && (!channelChanged('lento') || (d.lento is int && d.lento >= 0 && d.lento <= 21600));
      }

      /*
       * NÃO LIDAS (0.4.5): quem manda mensagem anota no canal a hora e o autor
       * da última. Qualquer membro, só estes dois campos, só para a frente e
       * sempre com o próprio uid.
       */
      allow update: if isMember(resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaEm', 'ultimaDe'])
        && request.resource.data.ultimaEm is string && request.resource.data.ultimaEm.size() <= 40
        && request.resource.data.ultimaEm > resource.data.get('ultimaEm', '')
        && request.resource.data.ultimaDe == uid();

      allow delete: if podeNoCanal(resource.data.groupId, channelId, 'apagar-canais');
    }

    /* ------------------------------- lidas ------------------------------- */
    // Não lidas (0.4.5): até onde a pessoa já leu cada conversa. Só ela.

    match /lidas/{userId} {
      allow read, delete: if signedIn() && userId == uid();
      allow create, update: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['marcas', 'desde'])
        && request.resource.data.marcas is map
        && request.resource.data.marcas.size() <= 500
        && request.resource.data.desde is string && request.resource.data.desde.size() <= 40;
    }

    /* ---------------------------- figurinhas ----------------------------- */
    // Figurinhas (0.5.0): as recentes (10) e as favoritas (até 300) de cada
    // pessoa. Só ela lê e mexe. O arquivo mora no R2 (pelo carteiro).

    match /figurinhas/{userId} {
      allow read, delete: if signedIn() && userId == uid();
      allow create, update: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['favoritas', 'recentes'])
        && request.resource.data.get('favoritas', []) is list
        && request.resource.data.get('favoritas', []).size() <= 300
        && request.resource.data.get('recentes', []) is list
        && request.resource.data.get('recentes', []).size() <= 10;
    }

    /* ---------------------------- infoDeTela ---------------------------- */
    // "Mandar informações da tela" (Configurações → Sobre, 23/11/2026): cada
    // pessoa só MANDA o retrato do próprio aparelho; ninguém lê nem muda pelo
    // app (o Léo lê pelo acesso de dono do projeto). Formato fechado e curto.

    match /infoDeTela/{infoId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['nome', 'quando', 'onde', 'versao', 'navegador',
             'telaW', 'telaH', 'janelaW', 'janelaH', 'densidade', 'letra', 'escuro', 'toque',
             'margens', 'recursos'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
        && request.resource.data.quando is string && request.resource.data.quando.size() <= 40
        && request.resource.data.onde in ['android', 'pc', 'site']
        && request.resource.data.versao is string && request.resource.data.versao.size() <= 20
        && request.resource.data.navegador is string && request.resource.data.navegador.size() <= 300
        && request.resource.data.margens is string && request.resource.data.margens.size() <= 60
        && request.resource.data.recursos is string && request.resource.data.recursos.size() <= 120
        && request.resource.data.telaW is number && request.resource.data.telaH is number
        && request.resource.data.janelaW is number && request.resource.data.janelaH is number
        && request.resource.data.densidade is number && request.resource.data.letra is number
        && request.resource.data.escuro is bool && request.resource.data.toque is bool;
      allow read, update, delete: if false;
    }

    /* ------------------------- aparelhos e avisos ------------------------ */
    // Notificações (0.4.0). `aparelhos/{uid}` = onde a pessoa quer receber
    // aviso (celular com o token do Google, ou PC). `avisos/{uid}` = o último
    // aviso para o PC, escrito só pelo carteiro (conta de serviço).

    match /aparelhos/{userId} {
      allow read, delete: if signedIn() && userId == uid();
      allow create, update: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['lista'])
        && request.resource.data.lista is map
        && request.resource.data.lista.size() <= 10;
    }

    /*
     * SILENCIAR (0.11.0): o que cada pessoa silenciou (canal, grupo, PV → até
     * quando). Só ela lê e escreve; o carteiro lê para não notificar.
     */
    match /silencios/{userId} {
      allow read, delete: if signedIn() && userId == uid();
      allow create, update: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['mapa'])
        && request.resource.data.mapa is map
        && request.resource.data.mapa.size() <= 500;
    }

    match /avisos/{userId} {
      allow read, delete: if signedIn() && userId == uid();
      allow create, update: if false;
    }

    /* ----------------------------- messages ----------------------------- */
    // `groupId` é denormalizado na mensagem justamente para esta regra: uma
    // consulta (exists da membership) em vez de duas (get do canal + exists),
    // vezes as 50 mensagens de cada lista.

    match /messages/{messageId} {
      // 0.8.5: só quem vê o canal lê (canal privado é privado de verdade).
      allow read: if podeVer(resource.data.groupId, resource.data.channelId);

      // 0.8.5: escrever no canal + a permissão do tipo (foto, GIF, vídeo,
      // áudio, figurinha). Na sala de voz vale "Escrever no chat da sala".
      allow create: if isMember(request.resource.data.groupId)
        && request.resource.data.authorId == uid()
        && podeEscrever(request.resource.data.groupId, request.resource.data.channelId)
        && tipoPermitido(request.resource.data)
        && unicaOk(request.resource.data)
        // 0.10.5: visualização única pede "Mandar visualização única" no canal.
        && (!('unica' in request.resource.data)
            || podeNoCanal(request.resource.data.groupId, request.resource.data.channelId, 'visualizacao-unica'))
        && lentoOk(request.resource.data.groupId, request.resource.data.channelId);

      /*
       * MODO LENTO (0.8.5): com `lento` (segundos) no canal, a mensagem vai
       * junto (no mesmo lote) com `lentos/{canal}_{uid}` marcando AGORA, e a
       * marca anterior tem de ter pelo menos `lento` segundos. Quem tem
       * "Ignorar o modo lento" não precisa.
       */
      function lentoOk(g, c) {
        let segundos = get(/databases/$(database)/documents/channels/$(c)).data.get('lento', 0);
        let marca = /databases/$(database)/documents/lentos/$(c + '_' + uid());
        return segundos == 0
          || podeNoCanal(g, c, 'ignorar-lento')
          || (existsAfter(marca) && getAfter(marca).data.em == request.time
              && (!exists(marca) || get(marca).data.em + duration.value(segundos, 's') <= request.time));
      }

      function podeEscrever(g, c) {
        return podeNoCanal(g, c,
          get(/databases/$(database)/documents/channels/$(c)).data.get('kind', 'text') == 'voice'
            ? 'escrever-chat-sala' : 'mandar-mensagens');
      }
      function tipoPermitido(d) {
        let k = d.get('kind', 'text');
        return k == 'text'
          || (k == 'image' && podeNoCanal(d.groupId, d.channelId, 'mandar-fotos'))
          || (k == 'gif' && podeNoCanal(d.groupId, d.channelId, 'mandar-gifs'))
          || (k == 'video' && podeNoCanal(d.groupId, d.channelId, 'mandar-videos'))
          || (k == 'audio' && podeNoCanal(d.groupId, d.channelId, 'mandar-audio'))
          || (k == 'sticker' && podeNoCanal(d.groupId, d.channelId, 'mandar-figurinhas'))
          || (k == 'file' && podeNoCanal(d.groupId, d.channelId, 'mandar-arquivos'));
      }

      // Editar é só do autor: ninguém põe palavra na boca de ninguém. Nem o
      // dono do grupo — ele pode APAGAR (moderação), não reescrever.
      //
      // E só o TEXTO. Até a etapa 12 esta regra era `authorId == uid()` e mais
      // nada, o que deixava o autor reescrever o passado: mudar `sentAt` para
      // reordenar a conversa, ou mover a própria mensagem para outro canal ou
      // outro grupo trocando `channelId`/`groupId`. O `hasOnly` abaixo é o que
      // fecha isso — nenhum outro campo pode ser tocado num update.
      allow update: if signedIn()
        && resource.data.authorId == uid()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['body', 'editedAt']);

      // 0.11.0: reagir — quem vê o canal e tem "Reagir", só a própria reação.
      allow update: if podeVer(resource.data.groupId, resource.data.channelId)
        && podeNoCanal(resource.data.groupId, resource.data.channelId, 'reagir')
        && soMinhaReacao();

      // Apagar é do autor OU do dono do grupo. O dono precisa disso por dois
      // motivos: moderação (decisão explícita, e o menu vai expor isso) e a
      // cascata de apagar o grupo — sem ele, as mensagens dos outros membros
      // ficariam no banco para sempre, sem grupo e sem membership, portanto
      // ilegíveis e inapagáveis por qualquer pessoa.
      allow delete: if signedIn()
        && (resource.data.authorId == uid() || isOwner(resource.data.groupId)
            || podeNoCanal(resource.data.groupId, resource.data.channelId, 'apagar-dos-outros'));
    }

    /* ------------------------------ invites ----------------------------- */

    match /invites/{code} {
      // LER pelo código tem que ser liberado a qualquer autenticado: quem foi
      // convidado ainda não é membro e precisa ver para onde está sendo
      // chamado. Por isso o convite carrega `groupName` — o documento do grupo
      // continua fechado a não-membros.
      allow get: if signedIn();

      // LISTAR continua fora de alcance para quase todo mundo, mas não pode ser
      // um `false` seco: a cascata de apagar o grupo precisa DESCOBRIR os
      // convites dele, e regra não faz query.
      //
      // `isOwner(resource.data.groupId)` resolve os dois lados de uma vez, pelo
      // mesmo mecanismo de "as regras não filtram": uma consulta que restringe
      // groupId a um grupo meu é provável pelas restrições e passa; uma listagem
      // da coleção inteira não é provável e continua negada. A varredura global
      // de convites segue impossível.
      allow list: if isOwner(resource.data.groupId) || pode(resource.data.groupId, 'gerenciar-convites');

      allow create: if pode(request.resource.data.groupId, 'criar-convites')
        && request.resource.data.createdBy == uid();

      allow update: if false;
      allow delete: if isOwner(resource.data.groupId) || pode(resource.data.groupId, 'gerenciar-convites');
    }

    /* ------------------------- voiceParticipants ------------------------ */
    // Quem está DE FATO num canal de voz. O id é determinístico
    // ({channelId}_{uid}), o que garante por construção um documento por pessoa
    // por canal — a regra de criação confere isso.
    //
    // `groupId` está no documento por causa DESTA regra: toda consulta precisa
    // restringir groupId para ser provável, senão é recusada inteira. Ver a
    // observação sobre "as regras não filtram" no topo deste arquivo.

    match /voiceParticipants/{participantId} {
      allow read: if naVoz(resource.data.groupId);

      // 0.8.5: entrar pede "Entrar"; falar e transmitir são cobrados no que
      // o documento diz (muted / sharingScreen).
      allow create: if podeNoCanal(request.resource.data.groupId, request.resource.data.channelId, 'entrar')
        && request.resource.data.uid == uid()
        && participantId == request.resource.data.channelId + '_' + uid()
        && vozOk(request.resource.data);

      // 0.9.5: ligação no PV — o "canal" é o próprio par, sem cargos.
      allow create: if ehDoPv(request.resource.data.groupId)
        && request.resource.data.channelId == request.resource.data.groupId
        && request.resource.data.uid == uid()
        && participantId == request.resource.data.channelId + '_' + uid();

      function vozOk(d) {
        return ehDoPv(d.groupId) || ((d.get('muted', true) == true || podeNoCanal(d.groupId, d.channelId, 'falar'))
          && (d.get('sharingScreen', false) != true || podeNoCanal(d.groupId, d.channelId, 'transmitir'))
          // 0.9.5: câmera = "Ligar câmera".
          && (d.get('camera', false) != true || podeNoCanal(d.groupId, d.channelId, 'camera'))
          && d.get('camera', false) is bool && d.get('cameraPausada', false) is bool);
      }

      // Só mexo no meu, e não posso me mudar de canal nem de grupo por update —
      // isso burlaria a checagem do id determinístico feita na criação.
      allow update: if resource.data.uid == uid()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.channelId == resource.data.channelId
        && request.resource.data.groupId == resource.data.groupId
        && (request.resource.data.get('muted', true) == resource.data.get('muted', true)
              && request.resource.data.get('sharingScreen', false) == resource.data.get('sharingScreen', false)
              && request.resource.data.get('camera', false) == resource.data.get('camera', false)
            || vozOk(request.resource.data));

      // Eu saio; o dono também pode tirar alguém da sala do próprio grupo.
      allow delete: if signedIn()
        && (resource.data.uid == uid() || isOwner(resource.data.groupId)
            || podeNoCanal(resource.data.groupId, resource.data.channelId, 'tirar-da-chamada'));
    }

    /* ------------------------------ signals ----------------------------- */
    // Sinalização WebRTC, um documento por PAR e por sentido: {de}_{para}.
    //
    // Cada lado escreve só o seu documento — ninguém escreve no do outro. É o
    // que torna esta regra trivial e o que elimina disputa de escrita entre os
    // dois pares negociando ao mesmo tempo.

    match /voiceChannels/{channelId}/signals/{signalId} {
      allow read: if naVoz(resource.data.groupId);

      allow create, update: if naVoz(request.resource.data.groupId)
        && request.resource.data.from == uid();

      // As DUAS pontas da conversa podem apagar, e mais ninguém. Quem recebe
      // precisa poder limpar sozinho: se a outra pessoa fechou o navegador à
      // força, os documentos dela ficariam para sempre — e sinalização velha não
      // é lixo inofensivo, é uma oferta antiga sendo consumida como nova.
      // O DONO também apaga, para o grupo apagado não deixar sinal órfão
      // (deleteGroupCascade, revisão 23/11/2026).
      allow delete: if signedIn()
        && (resource.data.from == uid() || resource.data.to == uid()
            || isOwner(resource.data.groupId));
    }
    /* ------------------------------- unicas ------------------------------ */
    /*
     * Quantas vezes cada pessoa já abriu uma visualização única (0.10.0).
     * Só o CARTEIRO escreve (conta de serviço, fora das regras). Lê quem
     * abriu (para ver quantas vezes sobram) e quem mandou ("Lucas abriu").
     */
    match /unicas/{id} {
      allow read: if signedIn() && (resource.data.uid == uid() || resource.data.autor == uid());
      allow write: if false;
    }

    /* ------------------------------ chamadas ----------------------------- */
    // 0.9.5: o TOQUE de uma ligação no PV. Um documento por par ({a}_{b}):
    // quem liga cria "tocando"; quem recebe atende ou recusa; quem ligou
    // marca perdida (30 s sem resposta) ou encerrada. Só amigos, sem bloqueio.

    match /chamadas/{par} {
      // Pelo CONTEÚDO, não pelo id: a consulta "chamadas para mim" é uma
      // lista, e nela o id do caminho não existe para a regra.
      allow read: if signedIn() && (resource.data.de == uid() || resource.data.para == uid());

      function chamadaOk(d) {
        return d.keys().hasOnly(['de', 'para', 'comCamera', 'estado', 'criadaEm', 'atendidaEm', 'fimEm'])
          && d.de is string && d.para is string && d.de != d.para
          && par.split('_').hasAll([d.de, d.para])
          && d.comCamera is bool
          && d.estado in ['tocando', 'atendida', 'recusada', 'perdida', 'encerrada', 'cancelada']
          && d.criadaEm is string && d.criadaEm.size() <= 40;
      }

      // Ligar: sou eu quem liga, para um AMIGO, sem bloqueio entre nós.
      allow create: if signedIn()
        && chamadaOk(request.resource.data)
        && request.resource.data.de == uid()
        && request.resource.data.estado == 'tocando'
        && get(/databases/$(database)/documents/friendships/$(par)).data.status == 'accepted'
        && !blockedBy(otherInPair(par))
        && !iBlocked(otherInPair(par));

      // Ligar de novo (o documento do par já existe) ou mudar o estado.
      allow update: if signedIn()
        && par.split('_').hasAny([uid()])
        && chamadaOk(request.resource.data)
        && (request.resource.data.estado != 'tocando'
            || (request.resource.data.de == uid()
                && get(/databases/$(database)/documents/friendships/$(par)).data.status == 'accepted'
                && !blockedBy(otherInPair(par))
                && !iBlocked(otherInPair(par))));

      allow delete: if signedIn() && par.split('_').hasAny([uid()]);
    }
  }
}
